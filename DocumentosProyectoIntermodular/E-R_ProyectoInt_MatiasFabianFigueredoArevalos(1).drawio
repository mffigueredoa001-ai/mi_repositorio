        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Entidades (Rectángulos)\n    CLI[CLIENTE]\n    PED[PEDIDO]\n    PROD[PRODUCTO]\n    UBI[UBICACION]\n    ENV[ENVIO]\n    USU[USUARIO]\n\n    %% Relaciones (Rombos)\n    R_REALIZA{realiza}\n    R_CONTIENE{contiene}\n    R_ALMACENADO{almacenado en}\n    R_ASIGNA{se asigna a}\n    R_REPARTE{reparte}\n\n    %% Conexiones de Cardinalidad (Formato del ejemplo)\n    CLI ---|\&quot;(1,1)\&quot;| R_REALIZA\n    R_REALIZA ---|\&quot;(0,N)\&quot;| PED\n\n    PED ---|\&quot;(1,N)\&quot;| R_CONTIENE\n    R_CONTIENE ---|\&quot;(1,N)\&quot;| PROD\n\n    PROD ---|\&quot;(1,N)\&quot;| R_ALMACENADO\n    R_ALMACENADO ---|\&quot;(1,N)\&quot;| UBI\n\n    PED ---|\&quot;(1,1)\&quot;| R_ASIGNA\n    R_ASIGNA ---|\&quot;(0,1)\&quot;| ENV\n\n    USU ---|\&quot;(1,1)\&quot;| R_REPARTE\n    R_REPARTE ---|\&quot;(0,N)\&quot;| ENV\n\n    %% Atributos CLIENTE (Óvalos)\n    A_CLI_ID([_id_cliente_])\n    A_CLI_NOM([nombre])\n    A_CLI_DIR([direccion])\n    CLI --- A_CLI_ID\n    CLI --- A_CLI_NOM\n    CLI --- A_CLI_DIR\n\n    %% Atributos PEDIDO\n    A_PED_ID([_id_pedido_])\n    A_PED_FEC([fecha_creacion])\n    A_PED_EST([estado])\n    PED --- A_PED_ID\n    PED --- A_PED_FEC\n    PED --- A_PED_EST\n\n    %% Atributos PRODUCTO\n    A_PROD_ID([_id_producto_])\n    A_PROD_COD([codigo])\n    A_PROD_NOM([nombre])\n    A_PROD_STOCK([stock_total])\n    PROD --- A_PROD_ID\n    PROD --- A_PROD_COD\n    PROD --- A_PROD_NOM\n    PROD --- A_PROD_STOCK\n\n    %% Atributos UBICACION\n    A_UBI_ID([_id_ubicacion_])\n    A_UBI_ZONA([zona])\n    A_UBI_PAS([pasillo])\n    UBI --- A_UBI_ID\n    UBI --- A_UBI_ZONA\n    UBI --- A_UBI_PAS\n\n    %% Atributos ENVIO\n    A_ENV_ID([_id_envio_])\n    A_ENV_VEH([vehiculo])\n    A_ENV_EST([estado_entrega])\n    ENV --- A_ENV_ID\n    ENV --- A_ENV_VEH\n    ENV --- A_ENV_EST\n\n    %% Atributos USUARIO\n    A_USU_ID([_id_usuario_])\n    A_USU_NOM([usuario_login])\n    A_USU_ROL([rol_puesto])\n    USU --- A_USU_ID\n    USU --- A_USU_NOM\n    USU --- A_USU_ROL\n\n    %% Atributos de las Relaciones N:M (Cuelgan del rombo)\n    A_CANT_PED([cantidad_producto])\n    R_CONTIENE --- A_CANT_PED\n\n    A_CANT_INV([cantidad_stock])\n    R_ALMACENADO --- A_CANT_INV&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="07VNQez5wNFeM0QYllNx-1">
